generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  active
  suspended
}

/// `testing` accounts order like customers, but their orders are left out of statistics.
enum UserRole {
  customer
  testing
}

enum AdminRole {
  super_admin
  admin
}

enum AdminStatus {
  active
  blocked
}

enum ChannelProvider {
  telegram
}

enum TelegramActorType {
  user
  admin
}

enum AdminInviteStatus {
  pending
  claimed
  approved
  rejected
  revoked
}

enum OrderStatus {
  waiting_payment
  paid
  waiting_action
  in_process
  done
  rejected
  cancel
}

enum OrderChannel {
  web
  telegram
  api
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum FulfillmentChannel {
  telegram
  whatsapp
  /// Forwarded automatically to an upstream Dhru supplier (Service.supplierId).
  supplier
}

enum ServiceInputType {
  imei
  sn
  ecid
  /// Layanan Spesial without a device value; the order carries only Qnt/Email/Username.
  none
}

/// User menu for supplier services: Order Ceir or Layanan Spesial.
enum ServiceMenu {
  ceir
  special
}

enum InvoicePurpose {
  order
  topup
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  cancelled
}

enum WhatsappNotificationStatus {
  pending
  sending
  sent
  failed
}

enum ResultStatus {
  success
  failed
}

model User {
  id              String              @id @default(cuid())
  username        String              @unique
  passwordHash    String              @map("password_hash")
  fullName        String              @map("full_name")
  telegramHandle  String?             @map("telegram_handle")
  creditBalance   Int                 @default(0) @map("credit_balance")
  role            UserRole            @default(customer)
  /// Pricing group; while set, group prices apply and personal prices are not used.
  groupId         String?             @map("group_id")
  group           UserGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status          UserStatus          @default(active)
  botAccess       Boolean             @default(true) @map("bot_access")
  /// Granted by Super Admin; required to create API keys and call the Dhru API.
  apiEnabled      Boolean             @default(false) @map("api_enabled")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  apiKeys         ApiKey[]
  webhookEndpoint WebhookEndpoint?
  sessions        UserSession[]
  identities      UserIdentity[]
  linkTokens      TelegramLinkToken[]
  orders          Order[]
  balanceEntries  BalanceEntry[]
  topupInvoices   PaymentInvoice[]

  @@map("users")
}

/// Append-only ledger of creditBalance changes; `refKey` makes each refund apply once.
model BalanceEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String
  refKey    String   @unique @map("ref_key")
  orderId   String?  @map("order_id")
  note      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("balance_entries")
}

/// Append-only activity trail shown to Super Admin; names are snapshots at event time.
model ActivityLog {
  id          String   @id @default(cuid())
  event       String
  category    String
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  actorName   String?  @map("actor_name")
  actorRole   String?  @map("actor_role")
  targetLabel String?  @map("target_label")
  orderId     String?  @map("order_id")
  summary     String
  ip          String?
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([event, createdAt])
  @@index([orderId])
  @@map("activity_logs")
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  ip         String?
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@map("user_sessions")
}

model UserIdentity {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  provider       ChannelProvider
  externalId     String          @map("external_id")
  chatId         String?         @map("chat_id")
  label          String?
  verifiedAt     DateTime        @default(now()) @map("verified_at")
  chatVerifiedAt DateTime?       @map("chat_verified_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([provider, chatId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

model TelegramLinkToken {
  id             String            @id @default(cuid())
  tokenHash      String            @map("token_hash")
  actorType      TelegramActorType @map("actor_type")
  userId         String?           @map("user_id")
  adminId        String?           @map("admin_id")
  telegramUserId String            @map("telegram_user_id")
  expiresAt      DateTime          @map("expires_at")
  consumedAt     DateTime?         @map("consumed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin          Admin?            @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([adminId])
  @@map("telegram_link_tokens")
}

model Admin {
  id                    String                      @id @default(cuid())
  username              String                      @unique
  passwordHash          String                      @map("password_hash")
  fullName              String                      @map("full_name")
  role                  AdminRole                   @default(super_admin)
  status                AdminStatus                 @default(active)
  totpSecret            String?                     @map("totp_secret")
  totpEnabledAt         DateTime?                   @map("totp_enabled_at")
  totpPrefs             Json?                       @map("totp_prefs")
  telegramUserId        String?                     @unique @map("telegram_user_id")
  telegramChatId        String?                     @unique @map("telegram_chat_id")
  telegramUsername      String?                     @map("telegram_username")
  telegramOauthLinkedAt DateTime?                   @map("telegram_oauth_linked_at")
  telegramLinkedAt      DateTime?                   @map("telegram_linked_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  sessions              AdminSession[]
  linkTokens            TelegramLinkToken[]
  telegramInvites       AdminTelegramInvite[]
  serviceAssignments    ServiceAssignment[]
  assignedOrders        Order[]                     @relation("OrderAssignedAdmin")
  orderResults          OrderResult[]
  orderNotifications    OrderTelegramNotification[]

  @@map("admins")
}

model AdminTelegramInvite {
  id                  String            @id @default(cuid())
  adminId             String            @map("admin_id")
  tokenHash           String            @unique @map("token_hash")
  status              AdminInviteStatus @default(pending)
  createdById         String            @map("created_by_id")
  expiresAt           DateTime          @map("expires_at")
  claimTelegramUserId String?           @map("claim_telegram_user_id")
  claimChatId         String?           @map("claim_chat_id")
  claimUsername       String?           @map("claim_username")
  claimName           String?           @map("claim_name")
  claimedAt           DateTime?         @map("claimed_at")
  decidedById         String?           @map("decided_by_id")
  decidedAt           DateTime?         @map("decided_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  admin               Admin             @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, status])
  @@map("admin_telegram_invites")
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String    @map("admin_id")
  ip         String?
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, lastSeenAt])
  @@map("admin_sessions")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Service {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  description        String
  price              Int
  /// Harga modal per order; snapshotted onto Order.costPrice when an order is created.
  costPrice          Int                 @default(0) @map("cost_price")
  estimate           String
  active             Boolean             @default(true)
  /// Where paid orders are processed: Telegram operators, or the WhatsApp group (Roamercheck).
  fulfillmentChannel FulfillmentChannel  @default(telegram) @map("fulfillment_channel")
  supplierId         String?             @map("supplier_id")
  /// Remote Dhru SERVICEID at the supplier.
  supplierServiceId  String?             @map("supplier_service_id")
  /// Which user menu lists a supplier service; ignored for Telegram/WhatsApp services.
  menu               ServiceMenu         @default(ceir)
  /// Layanan Spesial are priced in USD cents; price/costPrice hold the Rupiah value at the current rate.
  priceUsdCents      Int?                @map("price_usd_cents")
  costUsdCents       Int?                @map("cost_usd_cents")
  /// Layanan Spesial only: admin grouping for bulk price edits and the user's service picker.
  serviceGroupId     String?             @map("service_group_id")
  serviceGroup       ServiceGroup?       @relation(fields: [serviceGroupId], references: [id], onDelete: SetNull)
  /// What the user enters per order. Only Layanan Spesial services may use SN/ECID.
  inputType          ServiceInputType    @default(imei) @map("input_type")
  /// Layanan Spesial only: extra fields the user must fill per order, forwarded to the supplier.
  requireQnt         Boolean             @default(false) @map("require_qnt")
  requireEmail       Boolean             @default(false) @map("require_email")
  requireUsername    Boolean             @default(false) @map("require_username")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orders             Order[]
  assignments        ServiceAssignment[]
  groupPrices        UserGroupPrice[]

  @@index([serviceGroupId])
  @@map("services")
}

/// Group of Layanan Spesial services; unrelated to UserGroup (user pricing tiers).
model ServiceGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  services  Service[]

  @@map("service_groups")
}

/// Pricing group of users; services without a group price use Service.price.
model UserGroup {
  id          String           @id @default(cuid())
  name        String           @unique
  description String           @default("")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       User[]
  prices      UserGroupPrice[]

  @@map("user_groups")
}

model UserGroupPrice {
  groupId   String    @map("group_id")
  serviceId String    @map("service_id")
  price     Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([groupId, serviceId])
  @@map("user_group_prices")
}

model ServiceAssignment {
  serviceId String   @map("service_id")
  adminId   String   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([serviceId, adminId])
  @@index([adminId])
  @@map("service_assignments")
}

model Order {
  id                    String                      @id @default(cuid())
  orderId               String                      @unique @map("order_id")
  userId                String                      @map("user_id")
  serviceId             String                      @map("service_id")
  channel               OrderChannel                @default(web)
  /// Device value (IMEI/SN/ECID); "-" when the service's inputType is `none`.
  imei                  String
  notes                 String?
  /// Extra Layanan Spesial fields (Service.requireQnt/Email/Username); informational, not priced.
  quantity              Int?
  email                 String?
  username              String?
  status                OrderStatus                 @default(waiting_payment)
  /// Snapshot of the user's testing role at creation; excluded from statistics.
  isTest                Boolean                     @default(false) @map("is_test")
  /// Keterangan for rejected/cancelled orders; null means "tidak ada keterangan".
  statusReason          String?                     @map("status_reason")
  price                 Int
  /// Service cost price at creation time; profit = price - costPrice.
  costPrice             Int                         @default(0) @map("cost_price")
  assignedAdminId       String?                     @map("assigned_admin_id")
  invoiceId             String?                     @map("invoice_row_id")
  /// Key that placed the order through the Dhru API (channel `api`).
  apiKeyId              String?                     @map("api_key_id")
  /// Supplier the order was forwarded to, and its REFERENCEID there.
  supplierId            String?                     @map("supplier_id")
  supplierRef           String?                     @map("supplier_ref")
  supplierAttempts      Int                         @default(0) @map("supplier_attempts")
  supplierError         String?                     @map("supplier_error")
  supplierSubmittedAt   DateTime?                   @map("supplier_submitted_at")
  supplierCheckedAt     DateTime?                   @map("supplier_checked_at")
  startedAt             DateTime?                   @map("started_at")
  completedAt           DateTime?                   @map("completed_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  service               Service                     @relation(fields: [serviceId], references: [id])
  assignedAdmin         Admin?                      @relation("OrderAssignedAdmin", fields: [assignedAdminId], references: [id])
  invoice               PaymentInvoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  apiKey                ApiKey?                     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  supplier              Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  result                OrderResult?
  activity              OrderActivityLog[]
  telegramNotifications OrderTelegramNotification[]
  balanceEntries        BalanceEntry[]
  webhookDeliveries     WebhookDelivery[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([imei])
  @@index([invoiceId])
  @@index([supplierId, status])
  @@map("orders")
}

/// Upstream Dhru Fusion panel that supplier-routed services forward orders to.
model Supplier {
  id                 String    @id @default(cuid())
  name               String
  baseUrl            String    @map("base_url")
  username           String
  /// AES-256-GCM, see suppliers/supplier-secret.ts.
  apiKeyEnc          String    @map("api_key_enc")
  isActive           Boolean   @default(true) @map("is_active")
  lastBalance        String?   @map("last_balance")
  lastCheckedAt      DateTime? @map("last_checked_at")
  lastError          String?   @map("last_error")
  /// Services offered by the supplier at the last successful sync.
  remoteServiceCount Int?      @map("remote_service_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  services           Service[]
  orders             Order[]

  @@map("suppliers")
}

model OrderTelegramNotification {
  id         String    @id @default(cuid())
  orderId    String    @map("order_id")
  adminId    String    @map("admin_id")
  chatId     String    @map("chat_id")
  messageId  String?   @map("message_id")
  notifiedAt DateTime? @map("notified_at")
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at")
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([orderId, adminId])
  @@index([orderId])
  @@map("order_telegram_notifications")
}

model PaymentInvoice {
  id                   String                @id @default(cuid())
  invoiceId            String                @unique @map("invoice_id")
  purpose              InvoicePurpose        @default(order)
  isTest               Boolean               @default(false) @map("is_test")
  /// Owner of a topup invoice (topups have no orders).
  userId               String?               @map("user_id")
  /// Bulk total: one invoice pays for every order in `orders`.
  amount               Int
  /// Part of `amount` paid from creditBalance at checkout; the gateway charges the rest.
  balanceUsed          Int                   @default(0) @map("balance_used")
  amountDue            Int?                  @map("amount_due")
  qrisString           String?               @map("qris_string")
  checkoutUrl          String?               @map("checkout_url")
  paymentChannel       String                @default("qris_placeholder") @map("payment_channel")
  paymentReference     String?               @map("payment_reference")
  paymentStatus        PaymentStatus         @default(pending) @map("payment_status")
  expiredAt            DateTime              @map("expired_at")
  paidAt               DateTime?             @map("paid_at")
  gatewayPayload       Json?                 @map("gateway_payload")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  orders               Order[]
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNotification WhatsappNotification?

  @@index([paymentReference])
  @@index([userId, purpose, createdAt])
  @@map("payment_invoices")
}

/// Queued WhatsApp group message, one per paid invoice; retried until sent or attempts run out.
model WhatsappNotification {
  id            String                     @id @default(cuid())
  invoiceId     String                     @unique @map("invoice_row_id")
  kind          String
  chatId        String                     @map("chat_id")
  text          String
  status        WhatsappNotificationStatus @default(pending)
  attempts      Int                        @default(0)
  nextAttemptAt DateTime                   @default(now()) @map("next_attempt_at")
  sentAt        DateTime?                  @map("sent_at")
  wahaMessageId String?                    @map("waha_message_id")
  lastError     String?                    @map("last_error")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  invoice       PaymentInvoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("whatsapp_notifications")
}

model OrderActivityLog {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String
  actor     String
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_activity_logs")
}

model OrderResult {
  id               String       @id @default(cuid())
  orderId          String       @unique @map("order_id")
  resultStatus     ResultStatus @map("result_status")
  resultNote       String       @map("result_note")
  resultData       Json?        @map("result_data")
  /// Null when the result came from an external processor (Roamercheck).
  createdByAdminId String?      @map("created_by_admin_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByAdmin   Admin?       @relation(fields: [createdByAdminId], references: [id])

  @@map("order_results")
}

/// Dhru API credential; only the SHA-256 hash of the full key is stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  /// First characters of the key, used to find the row before comparing hashes.
  keyPrefix  String    @unique @map("key_prefix")
  keyHash    String    @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
  @@map("api_keys")
}

/// One callback URL per user; receives signed POSTs when API orders finish.
model WebhookEndpoint {
  id             String            @id @default(cuid())
  userId         String            @unique @map("user_id")
  url            String
  /// HMAC-SHA256 signing secret; kept readable because every delivery is signed with it.
  secret         String
  isActive       Boolean           @default(true) @map("is_active")
  /// Consecutive failed deliveries; the endpoint pauses at the limit.
  failureCount   Int               @default(0) @map("failure_count")
  lastStatus     String?           @map("last_status")
  lastDeliveryAt DateTime?         @map("last_delivery_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  endpointId    String                @map("endpoint_id")
  orderId       String                @map("order_id")
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(pending)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now()) @map("next_attempt_at")
  responseCode  Int?                  @map("response_code")
  lastError     String?               @map("last_error")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([endpointId, orderId, event])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Announcements scrolled as a ticker under the member portal header.
model RunningAd {
  id        String   @id @default(cuid())
  text      String
  linkUrl   String?  @map("link_url")
  /// Short label shown as a colored tag before the text (e.g. PROMO, INFO).
  tag       String?
  tagColor  String   @default("yellow") @map("tag_color")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("running_ads")
}

/// Images uploaded by Super Admin for rich service descriptions, served at /media/:id.
model MediaAsset {
  id        String   @id @default(cuid())
  mimeType  String   @map("mime_type")
  data      Bytes
  size      Int
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media_assets")
}
