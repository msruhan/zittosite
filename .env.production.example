# Production env for VPS — copy to /opt/zittosite/.env on the server.
# Never commit the real .env.
#
# Two modes (chosen automatically by scripts/deploy.sh):
#   - HTTPS (recommended): set WEB_DOMAIN/API_DOMAIN/ACME_EMAIL. Caddy serves TLS,
#     app ports bind to localhost, and the API refuses to start with placeholder
#     or identical JWT secrets.
#   - Plain HTTP: leave WEB_DOMAIN empty. App is served on :3000 / :4000 and the
#     same checks only log warnings. Use only until a domain is ready.

POSTGRES_USER=zittosite
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=zittosite

PORT=4000
# Generate each separately: openssl rand -hex 32
ADMIN_JWT_SECRET=
USER_JWT_SECRET=
# Key for encrypting admin 2FA secrets (openssl rand -hex 32). Existing 2FA
# secrets encrypted with ADMIN_JWT_SECRET keep working after this is set.
TOTP_ENCRYPTION_KEY=

# --- HTTPS mode (DNS A records must point to this server) ---
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
WEB_PUBLIC_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
# Auth cookies are scoped to the parent of WEB_PUBLIC_URL (www. stripped) so the
# web server can read cookies set by the API subdomain. Override only if needed.
# COOKIE_DOMAIN=example.com

# --- Plain HTTP mode (instead of the block above) ---
# WEB_DOMAIN=
# WEB_PUBLIC_URL=http://SERVER_IP:3000
# NEXT_PUBLIC_API_URL=http://SERVER_IP:4000
# CORS_ORIGINS=http://SERVER_IP:3000

# 1 = customers confirm payment with the "Saya sudah bayar" button (no gateway yet).
# Set to 0 once a real payment gateway is integrated.
PAYMENT_SIMULATION=1

# SayaBayar: API key from the dashboard (API menu). With it set, set PAYMENT_SIMULATION=0.
SAYABAYAR_API_KEY=
# platform (default) | client (paid plan, uses your own active channels)
# SAYABAYAR_CHANNEL_PREFERENCE=
# Add the webhook https://api.example.com/payments/sayabayar/webhook in the
# SayaBayar dashboard (events invoice.paid, invoice.expired, invoice.cancelled) and paste
# the secret it shows once here.
SAYABAYAR_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
TELEGRAM_OAUTH_REDIRECT_URI=https://app.example.com/auth/telegram/callback
# webhook is recommended in production; requires TELEGRAM_WEBHOOK_SECRET
# (openssl rand -hex 32) and setWebhook to https://api.example.com/webhooks/telegram
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp group notification on paid orders (WAHA). Leave WAHA_API_KEY empty to
# keep the WAHA container off. Setup: docs/whatsapp-waha-setup.md
# Generate: openssl rand -hex 32
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
# Group JID from GET /api/default/groups, e.g. 120363012345678901@g.us
WA_GROUP_CHAT_ID=
# WAHA_SESSION=default
# WAHA_BASE_URL=http://waha:3000
# Roamercheck status updates from the WA group (webhook WAHA → API). Off unless
# both are set. Secret: openssl rand -hex 32. Number: digits only, e.g. 6281319455208
WAHA_WEBHOOK_SECRET=
WA_PROCESSOR_NUMBER=
# Admin group for "WhatsApp Admin" services: one card per order, admins react
# ⏳/✅/❌. Needs WAHA_WEBHOOK_SECRET for the reactions. Group JID as above.
WA_ADMIN_GROUP_CHAT_ID=
