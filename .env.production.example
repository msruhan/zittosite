# Production env for VPS — copy to /opt/zittosite/.env on the server.
# Never commit the real .env.
#
# Two modes (chosen automatically by scripts/deploy.sh):
#   - HTTPS (recommended): set WEB_DOMAIN/API_DOMAIN/ACME_EMAIL. Caddy serves TLS,
#     app ports bind to localhost, and the API refuses to start with placeholder
#     or identical JWT secrets.
#   - Plain HTTP: leave WEB_DOMAIN empty. App is served on :3000 / :4000 and the
#     same checks only log warnings. Use only until a domain is ready.

POSTGRES_USER=zittosite
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=zittosite

PORT=4000
# Generate each separately: openssl rand -hex 32
ADMIN_JWT_SECRET=
USER_JWT_SECRET=
# Key for encrypting admin 2FA secrets (openssl rand -hex 32). Existing 2FA
# secrets encrypted with ADMIN_JWT_SECRET keep working after this is set.
TOTP_ENCRYPTION_KEY=

# --- HTTPS mode (DNS A records must point to this server) ---
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
WEB_PUBLIC_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com

# --- Plain HTTP mode (instead of the block above) ---
# WEB_DOMAIN=
# WEB_PUBLIC_URL=http://SERVER_IP:3000
# NEXT_PUBLIC_API_URL=http://SERVER_IP:4000
# CORS_ORIGINS=http://SERVER_IP:3000

# 1 = customers confirm payment with the "Saya sudah bayar" button (no gateway yet).
# Set to 0 once a real payment gateway is integrated.
PAYMENT_SIMULATION=1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
TELEGRAM_OAUTH_REDIRECT_URI=https://app.example.com/auth/telegram/callback
# webhook is recommended in production; requires TELEGRAM_WEBHOOK_SECRET
# (openssl rand -hex 32) and setWebhook to https://api.example.com/webhooks/telegram
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
