# Production env for VPS — copy to /opt/zittosite/.env on the server.
# Never commit the real .env.

POSTGRES_USER=zittosite
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=zittosite

# Used by API container (compose overrides host to postgres service)
DATABASE_URL=postgresql://zittosite:change-me-strong-password@postgres:5432/zittosite
DIRECT_URL=postgresql://zittosite:change-me-strong-password@postgres:5432/zittosite

PORT=4000
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars!!
USER_JWT_SECRET=change-me-user-jwt-secret-min-32-chars!!!

# Public URLs (use your domain later; IP works for smoke test)
WEB_PUBLIC_URL=http://187.53.138.144:3000
NEXT_PUBLIC_API_URL=http://187.53.138.144:4000

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
TELEGRAM_OAUTH_REDIRECT_URI=http://187.53.138.144:3000/auth/telegram/callback
TELEGRAM_MODE=polling
