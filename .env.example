DATABASE_URL=postgresql://zittosite:zittosite@localhost:5433/zittosite
DIRECT_URL=postgresql://zittosite:zittosite@localhost:5433/zittosite
# Supabase (staging): set DATABASE_URL (pooler :6543?pgbouncer=true) + DIRECT_URL (session :5432)
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PORT=4000
# Generate: openssl rand -hex 32 (min 32 chars each)
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-32chars-min
USER_JWT_SECRET=dev-user-jwt-secret-change-me-32chars-min
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dev only: enables the "Saya sudah bayar" simulated payment. Never in production.
PAYMENT_SIMULATION=1
NEXT_PUBLIC_PAYMENT_SIMULATION=1

# SayaBayar payment gateway. Orders get a real QRIS invoice when SAYABAYAR_API_KEY is set;
# otherwise the placeholder QR + PAYMENT_SIMULATION flow is used.
SAYABAYAR_API_KEY=
# SAYABAYAR_API_BASE=https://api.sayabayar.com/v1
# qris (default) | bca_transfer | va_bca, va_bni, va_bri, ... (VA needs KYC + VA enabled)
# SAYABAYAR_PAYMENT_METHOD=qris
# platform (default) | client (paid plan, uses your own active channels)
# SAYABAYAR_CHANNEL_PREFERENCE=
# SayaBayar webhook secret (shown once when adding the webhook in the SayaBayar dashboard).
# Webhook URL: <API URL>/payments/sayabayar/webhook — events: invoice.paid, invoice.expired, invoice.cancelled
SAYABAYAR_WEBHOOK_SECRET=

# Telegram Phase 1 (optional — bot disabled if TELEGRAM_BOT_TOKEN empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
TELEGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/auth/telegram/callback
TELEGRAM_MODE=polling
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOW_PROD_POLLING=1

# WhatsApp group notification on paid orders (WAHA). Off unless WAHA_BASE_URL,
# WAHA_API_KEY and WA_GROUP_CHAT_ID are set. WAHA_MOCK=1 logs messages instead.
# WAHA_MOCK=1
WAHA_BASE_URL=
WAHA_API_KEY=
WA_GROUP_CHAT_ID=
# WAHA_SESSION=default
# Roamercheck status updates (WAHA webhook → POST /webhooks/waha, HMAC-SHA512).
WAHA_WEBHOOK_SECRET=
WA_PROCESSOR_NUMBER=